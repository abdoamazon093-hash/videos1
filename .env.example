# Application Settings
APP_NAME=Videos1
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8095

# Security & Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key
API_KEY=your-api-key-here

# Database / SQLite Cache
DATABASE_URL=sqlite:///./cache.db
