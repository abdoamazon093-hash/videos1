# ==========================================================
# Example Environment Configuration (Template Only)
# Do NOT put real secrets or API keys in this file.
# Copy this file to .env and fill in your actual values locally.
# ==========================================================

# Application Settings
APP_NAME=Videos1 - German Unified Platform
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8095

# Security & Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key
API_KEY=your-api-key-here

# Database / SQLite Cache
DATABASE_URL=sqlite:///./cache.db

# AI & Speech Integrations (Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Telegram Backups
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Internal Microservice Routing (Defaults to localhost ports)
VOCAB_TUTOR_URL=http://127.0.0.1:8085
GERMAN_COACH_URL=http://127.0.0.1:8000
